#!/usr/bin/env bash

set -eu

# Usage
# upload_artifact $file_path
#
# $file_path is the path to a file on disk. It'll automatically be combined with the current build ID to differentiate between
# the same file in different jobs so that it can be correctly re-downloaded within the same job.
#
# On CI agents that set the `BUILDKITE_NAS_ARTIFACTS_S3_*` variables (our macOS fleet in MacMiniVault), the file is uploaded
# to the S3 server on the Synology NAS, to avoid billed S3 egress when `download_artifact` fetches it from the same LAN.
# It is uploaded to S3 only if the NAS upload fails.

if [ -z "${1-}" ]; then
	echo "You must pass the file you want to be stored"
	exit 1
else
	ARTIFACT_PATH=$1
fi

if [ ! -f "$ARTIFACT_PATH" ]; then
	echo "No file found at $ARTIFACT_PATH"
	exit 2
fi

BUCKET=${ARTIFACTS_S3_BUCKET-}

if [ -z "$BUCKET" ]; then
	echo "You must pass set the \`ARTIFACTS_S3_BUCKET\` environment variable with the S3 bucket you'd like to use"
	exit 3
fi

BASENAME=$(basename "$ARTIFACT_PATH")
KEY="$BUILDKITE_BUILD_ID/$BASENAME"

NAS_ENDPOINT=${BUILDKITE_NAS_ARTIFACTS_S3_ENDPOINT:-}
NAS_BUCKET=${BUILDKITE_NAS_ARTIFACTS_S3_BUCKET:-}
NAS_ACCESS_KEY_ID=${BUILDKITE_NAS_ARTIFACTS_S3_ACCESS_KEY_ID:-}
NAS_SECRET_ACCESS_KEY=${BUILDKITE_NAS_ARTIFACTS_S3_SECRET_ACCESS_KEY:-}

SHOULD_TRY_NAS=false
[[ -n "$NAS_ENDPOINT" && -n "$NAS_BUCKET" && -n "$NAS_ACCESS_KEY_ID" && -n "$NAS_SECRET_ACCESS_KEY" ]] && SHOULD_TRY_NAS=true

# The NAS credentials replace the agent's AWS credentials for this one call, so the AWS ones never reach the NAS.
aws_nas() {
	env -u AWS_PROFILE -u AWS_SESSION_TOKEN \
		AWS_ACCESS_KEY_ID="$NAS_ACCESS_KEY_ID" AWS_SECRET_ACCESS_KEY="$NAS_SECRET_ACCESS_KEY" AWS_MAX_ATTEMPTS=1 \
		aws s3 "$@" --endpoint-url "$NAS_ENDPOINT" --region us-east-1 --cli-connect-timeout 5
}

upload_to_nas() {
	[[ "$SHOULD_TRY_NAS" == true ]] || return 1
	echo "Uploading to NAS (Synology)"
	aws_nas cp "$ARTIFACT_PATH" "s3://$NAS_BUCKET/$BUILDKITE_BUILD_ID-$BASENAME"
}

upload_to_s3() {
	# If the bucket has transfer acceleration enabled, use it!
	local acceleration_status
	acceleration_status=$(aws s3api get-bucket-accelerate-configuration --bucket "$BUCKET" | jq '.Status' -r || true)

	if [[ "$acceleration_status" == "Enabled" ]]; then
		echo "Uploading to S3 with transfer acceleration"
		aws s3 cp "$ARTIFACT_PATH" "s3://$BUCKET/$KEY" --endpoint-url https://s3-accelerate.amazonaws.com
	else
		echo "Uploading to S3"
		aws s3 cp "$ARTIFACT_PATH" "s3://$BUCKET/$KEY"
	fi || return 1

	if [[ "$SHOULD_TRY_NAS" == true ]]; then
		annotate "NAS upload failed, uploaded to S3 instead: \`$BASENAME\`"
	fi
}

annotate() {
	command -v buildkite-agent > /dev/null 2>&1 || return 0
	printf -- "- %s\n" "$1" | buildkite-agent annotate --context nas-artifacts --scope job --style warning --append || echo "⚠️ nas-artifacts annotation failed"
}

upload_to_nas || upload_to_s3
