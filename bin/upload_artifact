#!/usr/bin/env bash
# shellcheck disable=SC2030,SC2031 # run_against_nas changes variables only inside its subshell, on purpose.

set -eu

# On our macOS fleet, the Synology NAS runs an S3 server on the same LAN.
# There, this script runs first against the NAS, and against AWS S3 only if that fails.

is_nas_configured() {
	[[ -n "${BUILDKITE_NAS_ARTIFACTS_S3_ENDPOINT:-}" ]]
}

is_running_against_nas() {
	[[ -n "${RUNNING_AGAINST_NAS:-}" ]]
}

# Runs this same script again, in a subshell where every `aws s3` call goes to the NAS.
run_against_nas() (
	export RUNNING_AGAINST_NAS=true
	export AWS_ENDPOINT_URL_S3="$BUILDKITE_NAS_ARTIFACTS_S3_ENDPOINT"
	export AWS_ACCESS_KEY_ID="$BUILDKITE_NAS_ARTIFACTS_S3_ACCESS_KEY_ID"
	export AWS_SECRET_ACCESS_KEY="$BUILDKITE_NAS_ARTIFACTS_S3_SECRET_ACCESS_KEY"
	unset AWS_PROFILE AWS_SESSION_TOKEN
	export AWS_MAX_ATTEMPTS=1
	export ARTIFACTS_S3_BUCKET="$BUILDKITE_NAS_ARTIFACTS_S3_BUCKET"
	# Run this script again, with the same arguments.
	"$0" "$@"
)

if is_nas_configured && ! is_running_against_nas; then
	if run_against_nas "$@"; then
		exit 0
	fi
	echo "NAS failed, using AWS S3"
fi

# Usage
# upload_artifact $file_path
#
# $file_path is the path to a file on disk. It'll automatically be combined with the current build ID to differentiate between
# the same file in different jobs so that it can be correctly re-downloaded within the same job.

if [ -z "${1-}" ]; then
	echo "You must pass the file you want to be stored"
	exit 1
else
	ARTIFACT_PATH=$1
fi

if [ ! -f "$ARTIFACT_PATH" ]; then
	echo "No file found at $ARTIFACT_PATH"
	exit 2
fi

BUCKET=${ARTIFACTS_S3_BUCKET-}

if [ -z "$BUCKET" ]; then
	echo "You must pass set the \`ARTIFACTS_S3_BUCKET\` environment variable with the S3 bucket you'd like to use"
	exit 3
fi

BASENAME=$(basename "$ARTIFACT_PATH")
KEY="$BUILDKITE_BUILD_ID/$BASENAME"

# If the bucket has transfer acceleration enabled, use it!
ACCELERATION_STATUS=$(aws s3api get-bucket-accelerate-configuration --bucket "$BUCKET" | jq '.Status' -r || true)

if [ "$ACCELERATION_STATUS" = "Enabled" ]; then
	echo "Uploading with transfer acceleration"
	aws s3 cp "$ARTIFACT_PATH" "s3://$BUCKET/$KEY" --endpoint-url https://s3-accelerate.amazonaws.com
else
	aws s3 cp "$ARTIFACT_PATH" "s3://$BUCKET/$KEY"
fi
