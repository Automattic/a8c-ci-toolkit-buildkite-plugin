#!/usr/bin/env bash

set -euo pipefail

# Script: install_a8c-secrets_binary
#
# Description:
#   Installs the `a8c-secrets` CLI on a CI agent, pinned to a known release and
#   verified against a vendored SHA-256 checksum before it is put on disk.
#
#   Bumping the version: update `A8C_SECRETS_VERSION` and every `A8C_SECRETS_CHECKSUM_*`
#   constant together, as the checksums are only valid for the pinned version. Get a new
#   checksum with `shasum -a 256` on the downloaded release asset.
#
# Usage:
#   install_a8c-secrets_binary [--os <os>] [--arch <arch>] [--install-dir <path>]
#
# Options:
#   --os <os>              Target platform, in `uname -s` form (e.g. `Darwin`). Defaults
#                          to the host's.
#   --arch <arch>          Target architecture, in `uname -m` form (e.g. `arm64`).
#                          Defaults to the host's.
#   --install-dir <path>   Directory to install the binary into. Defaults to the
#                          location described in the notes below.
#   -h, --help             Print usage and exit.
#
# Examples:
#   install_a8c-secrets_binary
#   install_a8c-secrets_binary --os Linux --arch x86_64
#   install_a8c-secrets_binary --install-dir "$HOME/bin"
#
# Notes:
#   Without `--install-dir`, installs to `/usr/local/bin` when writable,
#   otherwise `$HOME/.local/bin`. The latter is not always on the agent's PATH
#   so the command prints a reminder to add it when that is the case. Windows
#   (MSYS/MinGW bash) is supported on a best-effort basis, mirroring upstream.
#
# Returns:
#   0 on success; 1 on usage, download or checksum error; 2 on an unsupported platform
#   or a target with no pinned checksum.
#
# Requirements:
#   `curl`, `install`, `uname`, and the toolkit's own `hash_file` helper.

# The pinned release and the SHA-256 of each `a8c-secrets-<triple>-$A8C_SECRETS_VERSION`
# asset we publish and have vetted.
A8C_SECRETS_VERSION="1.0.0"
A8C_SECRETS_CHECKSUM_AARCH64_APPLE_DARWIN="2b59604261053d2b57a805c53e3b727c43b750e821b587c0492dee7f717bab24"
A8C_SECRETS_CHECKSUM_X86_64_UNKNOWN_LINUX_GNU="b8fd670c430843ff5af954a85903dc1726d5ca8e3294f725e5e521ac86683bf7"
A8C_SECRETS_CHECKSUM_X86_64_PC_WINDOWS_GNU="fd58cc1f7330de1078042ad1cb7afcb127ac66e8de840f202b03b70fd829b086"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Download scratch dir, removed on exit. Populated by main once it downloads; the trap
# runs in the global scope where main's locals are gone, so this has to live out here.
TMP_DIR=""
cleanup() {
	if [[ -n "$TMP_DIR" ]]; then
		rm -rf "$TMP_DIR"
	fi
}
trap cleanup EXIT

usage() {
	echo "usage: install_a8c-secrets_binary [--os <os>] [--arch <arch>] [--install-dir <path>]"
}

# Map `uname -s` / `uname -m` to the Rust target triple used in the release asset
# names. Mirrors the mapping in a8c-secrets' own install.sh. Returns non-zero for a
# platform we don't build for.
resolve_target_triple() {
	local os="$1" arch="$2"
	case "$os" in
		Darwin)
			case "$arch" in
				arm64) echo "aarch64-apple-darwin" ;;
				x86_64) echo "x86_64-apple-darwin" ;;
				*) return 1 ;;
			esac
			;;
		Linux)
			case "$arch" in
				x86_64) echo "x86_64-unknown-linux-gnu" ;;
				aarch64 | arm64) echo "aarch64-unknown-linux-gnu" ;;
				*) return 1 ;;
			esac
			;;
		MINGW* | MSYS* | CYGWIN*)
			case "$arch" in
				x86_64) echo "x86_64-pc-windows-gnu" ;;
				*) return 1 ;;
			esac
			;;
		*) return 1 ;;
	esac
}

# Only triples with a pinned checksum are installable; a resolvable triple with none
# (e.g. a target upstream didn't publish for this version) is refused.
expected_checksum() {
	case "$1" in
		aarch64-apple-darwin) echo "$A8C_SECRETS_CHECKSUM_AARCH64_APPLE_DARWIN" ;;
		x86_64-unknown-linux-gnu) echo "$A8C_SECRETS_CHECKSUM_X86_64_UNKNOWN_LINUX_GNU" ;;
		x86_64-pc-windows-gnu) echo "$A8C_SECRETS_CHECKSUM_X86_64_PC_WINDOWS_GNU" ;;
		*) return 1 ;;
	esac
}

# Where to put the binary: the `--install-dir` value when given, otherwise the default
# location upstream's install.sh picks for the target.
resolve_install_dir() {
	local triple="$1" override="${2:-}" local_app_data_dir
	if [[ -n "$override" ]]; then
		echo "$override"
	elif [[ "$triple" == *windows* ]]; then
		local_app_data_dir="${LOCALAPPDATA:+$LOCALAPPDATA/Programs/a8c-secrets}"
		echo "${local_app_data_dir:-$HOME/.local/bin}"
	elif [[ -w "/usr/local/bin" ]]; then
		echo "/usr/local/bin"
	else
		echo "$HOME/.local/bin"
	fi
}

main() {
	local os="" arch="" install_dir=""
	while [[ $# -gt 0 ]]; do
		case "$1" in
			-h | --help)
				usage
				return 0
				;;
			--os | --arch | --install-dir)
				if [[ $# -lt 2 ]]; then
					echo "missing value for $1" >&2
					usage >&2
					return 1
				fi
				case "$1" in
					--os) os="$2" ;;
					--arch) arch="$2" ;;
					--install-dir) install_dir="$2" ;;
				esac
				shift 2
				;;
			*)
				echo "unknown option: $1" >&2
				usage >&2
				return 1
				;;
		esac
	done

	echo "--- :closed_lock_with_key: Installing a8c-secrets $A8C_SECRETS_VERSION"

	local triple
	os="${os:-$(uname -s)}"
	arch="${arch:-$(uname -m)}"

	if ! triple="$(resolve_target_triple "$os" "$arch")"; then
		echo "Unsupported platform for a8c-secrets: os=$os arch=$arch" >&2
		return 2
	fi

	local checksum
	if ! checksum="$(expected_checksum "$triple")"; then
		echo "No pinned checksum for target '$triple' at a8c-secrets $A8C_SECRETS_VERSION." >&2
		echo "If a binary actually exists on a8c-secrets' GitHub Releases for this triple and version, add its checksum to install_a8c-secrets_binary (see the bump procedure in its header)." >&2
		return 2
	fi

	local exe_name asset_suffix install_cmd
	if [[ "$triple" == *windows* ]]; then
		exe_name="a8c-secrets.exe"
		asset_suffix=".exe"
		install_cmd="/usr/bin/install"
	else
		exe_name="a8c-secrets"
		asset_suffix=""
		install_cmd="install"
	fi

	local asset url
	asset="a8c-secrets-${triple}-${A8C_SECRETS_VERSION}${asset_suffix}"
	url="https://github.com/Automattic/a8c-secrets/releases/download/${A8C_SECRETS_VERSION}/${asset}"

	install_dir="$(resolve_install_dir "$triple" "$install_dir")"

	local tmp_bin
	TMP_DIR="$(mktemp -d)"
	tmp_bin="$TMP_DIR/$exe_name"

	echo "Downloading $asset..."
	if ! curl --location --silent --show-error --fail --output "$tmp_bin" "$url"; then
		echo "Failed to download $asset from $url" >&2
		return 1
	fi

	echo "Verifying checksum..."
	local actual
	actual="$("$SCRIPT_DIR/hash_file" "$tmp_bin")"
	if [[ "$actual" != "$checksum" ]]; then
		echo "Checksum mismatch for $asset" >&2
		echo "  expected: $checksum" >&2
		echo "  actual:   $actual" >&2
		return 1
	fi

	local install_path="$install_dir/$exe_name"
	echo "Installing to $install_path..."
	"$install_cmd" -d "$install_dir"
	"$install_cmd" -m 755 "$tmp_bin" "$install_path"

	# a8c-secrets is downloaded, not built locally, so macOS quarantines it.
	if [[ "$os" == "Darwin" ]]; then
		echo "Removing quarantine attribute from $install_path..."
		xattr -d com.apple.quarantine "$install_path" 2>/dev/null || true
	fi

	echo "Successfully installed a8c-secrets to $install_path"
	if [[ ":$PATH:" != *":$install_dir:"* ]]; then
		echo "Note: $install_dir is not on your PATH. Add it with:"
		echo "  export PATH=\"$install_dir:\$PATH\""
	fi
}

# Run unless sourced, so the tests can source and unit-test the pure functions above.
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
	main "$@"
fi
