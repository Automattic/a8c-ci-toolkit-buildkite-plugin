#!/usr/bin/env ruby
# frozen_string_literal: true

require 'rbconfig'

os = RbConfig::CONFIG['host_os']

version = case os
when /linux/
  puts '~~~ ldd version'
  puts `ldd --version`
  puts '~~~ ldd version | head -n 1'
  puts `ldd --version | head -n 1`
  puts '~~~ ldd version | head -n 1 | grep -o ...'
  puts `ldd --version | head -n 1 | grep -o "[0-9][0-9]*\.[0-9][0-9]*"`
  "linux-#{`ldd --version | head -n 1 | grep -o "[0-9][0-9]*\.[0-9][0-9]*" || echo "unknown"`}"
when /darwin/
  "macos-#{`sw_vers -productVersion 2>/dev/null || echo "unknown"`}"
when /mswin|mingw|windows/
  # Get Windows version using PowerShell
  "win-#{`powershell -Command "[System.Environment]::OSVersion.Version.ToString()" 2>/dev/null || echo "unknown"`}"
else
  'unknown'
end

print version
