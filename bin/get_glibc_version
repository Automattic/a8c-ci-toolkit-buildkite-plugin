#!/usr/bin/env ruby
# frozen_string_literal: true

require 'rbconfig'

os = RbConfig::CONFIG['host_os']

if os =~ /linux/
  puts '~~~ ldd version'
  puts `ldd --version`
  puts '~~~ ldd version | head -n 1'
  puts `ldd --version | head -n 1`
  puts '~~~ ldd version | head -n 1 | grep -o ...'
  puts `ldd --version | head -n 1 | grep -o "[0-9][0-9]*\.[0-9][0-9]*"`
  version = "linux-#{`ldd --version | head -n 1 | grep -o "[0-9][0-9]*\.[0-9][0-9]*" || echo "unknown"`}"
elsif os =~ /darwin/
  version = "macos-#{`sw_vers -productVersion 2>/dev/null || echo "unknown"`}"
elsif os =~ /mswin|mingw|windows/
  # Get Windows version using PowerShell
  version = "win-#{`powershell -Command "[System.Environment]::OSVersion.Version.ToString()" 2>/dev/null || echo "unknown"`}"
else
  version = 'unknown'
end

print version
