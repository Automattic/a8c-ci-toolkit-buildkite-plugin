#!/usr/bin/env bash

set -eu

PLATFORM=$(uname -s)
ARCHITECTURE=$(uname -m)
if command -v rbenv > /dev/null; then
  if ! RUBY_VERSION=$(rbenv version-name); then
    echo "Ruby versions installed on this agent:"
    rbenv versions --bare | sed 's/^/  /'
    exit 1
  fi
else
  RUBY_VERSION=$(cat .ruby-version)
fi
GEMFILE_HASH=$(hash_file Gemfile.lock)
# Many of our projects require nokogiri, which may result in issues if the
# cache is built on an environment with a different libc version than the one
# where it is downloaded. To avoid issues, add the libc version to the cache
# key if the Gemfile.lock includes nokogiri.
if grep -q "nokogiri" Gemfile.lock; then
  LIBC_VERSION="-libc$("$(dirname "${BASH_SOURCE[0]}")"/get_libc_version)"
else
  LIBC_VERSION=''
fi
# The `openssl` gem's native extension links to the OpenSSL it was built against by absolute path,
# e.g. `/opt/homebrew/opt/openssl@3/lib/libssl.3.dylib`. Mac CI images can swap Homebrew's OpenSSL
# (e.g. `openssl@3` for `openssl@4`) without changing the macOS or Ruby version, and a cache built on
# one image then fails to load on the other. To avoid that, add the installed Homebrew OpenSSL
# formulae to the cache key if the Gemfile.lock includes the `openssl` gem.
OPENSSL_VERSIONS=''
if [[ "$PLATFORM" == 'Darwin' ]] && grep -qE '^    openssl \(' Gemfile.lock && command -v brew > /dev/null; then
  OPENSSL_VERSIONS=$(brew list --formula --versions | awk '/^openssl@/ { gsub(/ /, "-"); printf "-%s", $0 }')
  OPENSSL_VERSIONS=${OPENSSL_VERSIONS:--openssl-none}
fi
CACHEKEY="$BUILDKITE_PIPELINE_SLUG-$PLATFORM-$ARCHITECTURE$LIBC_VERSION$OPENSSL_VERSIONS-ruby$RUBY_VERSION-$GEMFILE_HASH"

restore_cache "$CACHEKEY"

# Install the same Bundler version as the one in the Gemfile.lock.
# This should prevent runtime issues where Ruby "gets confused" on which Bundler version to use.
# See https://github.com/Automattic/a8c-ci-toolkit-buildkite-plugin/issues/16 for more details.
GEMFILE_LOCK_BUNDLER_VERSION=$(sed -n -e '/BUNDLED WITH/{n;s/ *//p;}' Gemfile.lock)
# The command will fail if the `--version` parameter is empty; we can omit checking for that ourselves.
gem install bundler --version "$GEMFILE_LOCK_BUNDLER_VERSION"

bundle install

# If this is the first time we've seen this particular cache key, save it for the future
save_cache vendor/bundle "$CACHEKEY"
