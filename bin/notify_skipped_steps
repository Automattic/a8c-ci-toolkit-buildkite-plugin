#!/usr/bin/env python3

# Makes Buildkite report GitHub commit statuses even for steps skipped by `skip:` or `if_changed:`, which otherwise never send their `notify:`.
# Also posts an annotation listing the skipped steps and why they were skipped.
#
# Usage:
#   notify_skipped_steps [pipeline file]
#
#   Like `buildkite-agent pipeline upload`, it reads the file as given (no lookup in `.buildkite/`) or, without an argument, STDIN.
#   It prints the pipeline it read, unchanged, on STDOUT, and everything else on STDERR, so it can be called before the upload:
#     notify_skipped_steps .buildkite/pipeline.yml
#     buildkite-agent pipeline upload .buildkite/pipeline.yml
#   or in front of it, which avoids repeating the path (use `set -o pipefail`, so that a failure here fails the step instead of uploading an empty pipeline):
#     notify_skipped_steps .buildkite/pipeline.yml | buildkite-agent pipeline upload
#   Run it in the step that runs the upload (it needs Python 3 and a running job).
#
# Opt in by listing the `key` of each step (or group) in a top-level `notify_skipped_github_statuses`; its `github_commit_status` entries are then reported when it is skipped:
#   notify_skipped_github_statuses: [swiftlint]
#   steps:
#     - key: swiftlint
#       label: Lint Swift Files
#       command: .buildkite/commands/run-swiftlint.sh
#       if_changed: ["**/*.swift"]
#       notify:
#         - github_commit_status: { context: "SwiftLint" }
#
# For skip logic `if_changed` can't express easily, compute it in `shared-pipeline-vars`, e.g.
#   export SKIP_UI_TESTS=$(.buildkite/commands/should-skip-job.sh ui-tests)
# and use `skip: $SKIP_UI_TESTS`. Such a script should print the reason to skip, or `false` (or nothing) to run the step.
#
# How it works: it dry-runs the upload (`buildkite-agent pipeline upload --dry-run`), so interpolation and `if_changed` are already applied, to determine which steps would be skipped. Then, for each such skipped step listed, it attaches its `github_commit_status` entries to the running step via `buildkite-agent step update`; the statuses are sent when the job for the real pipeline upload step finishes.
# The pipeline is uploaded as it is: the list is a top-level key Buildkite's pipeline schema allows (unlike a custom attribute inside a `notify` entry), and Buildkite ignores it.
# Exits 0, printing the pipeline, if all went well or there is no list; exits 1, printing nothing, on a missing file or input, a failed dry run, a list that isn't a list, a key that matches no step, or a listed step without a `github_commit_status` or with one without a `context`.

import json
import subprocess
import sys

LIST = 'notify_skipped_github_statuses'

args = sys.argv[1:]
if args:
    try:
        with open(args[0]) as f:
            source = f.read()
    except OSError as error:
        sys.exit("notify_skipped_steps: cannot read the pipeline file: %s" % error)
elif not sys.stdin.isatty():
    source = sys.stdin.read()
else:
    sys.exit("usage: notify_skipped_steps [pipeline file] (reads STDIN without a file)")
if not source.strip():
    sys.exit("notify_skipped_steps: the pipeline is empty")

if LIST not in source:
    sys.stdout.write(source)
    sys.exit(0)

dry_run = subprocess.run(['buildkite-agent', 'pipeline', 'upload', '--dry-run', '--format', 'json'], input=source, capture_output=True, text=True)
sys.stderr.write(dry_run.stderr)
if dry_run.returncode != 0:
    sys.exit("buildkite-agent pipeline upload --dry-run failed")
pipeline = json.loads(dry_run.stdout)

listed = pipeline.get(LIST)
if not isinstance(listed, list):
    sys.exit("notify_skipped_steps: %s must be a list of step keys" % LIST)
wanted = set(map(str, listed))


def is_skipped(step):
    skip = step.get('skip')
    return skip not in (None, False, '') and str(skip).lower() != 'false'


def steps_with_skip(steps, inherited=None):
    """Yields (step, skip) for each step, group members before their group. `skip` is None when the step runs.
    The agent sets `skip` on a skipped group only, so `inherited` is the `skip` of the nearest skipped group above."""
    for step in steps or []:
        if not isinstance(step, dict):  # e.g. a bare `wait`
            continue
        skip = step['skip'] if is_skipped(step) else inherited
        yield from steps_with_skip(step.get('steps'), skip)
        yield (step, skip)


def contexts_of(step):
    contexts = []
    for entry in step.get('notify') or []:
        if isinstance(entry, dict) and isinstance(entry.get('github_commit_status'), dict):
            context = entry['github_commit_status'].get('context')
            if not context:
                sys.exit("notify_skipped_steps: the github_commit_status of step %s needs a `context`" % step['key'])
            contexts.append(context)
    if not contexts:
        sys.exit("notify_skipped_steps: step %s is listed in %s but has no github_commit_status" % (step['key'], LIST))
    return contexts


listed_steps = [(step, skip) for step, skip in steps_with_skip(pipeline.get('steps')) if step.get('key') is not None and str(step['key']) in wanted]
unknown = wanted - {str(step['key']) for step, _ in listed_steps}
if unknown:
    sys.exit("notify_skipped_steps: %s lists keys that match no step: %s" % (LIST, ', '.join(sorted(unknown))))

skipped = []  # (label, reason, contexts)
for step, skip in listed_steps:
    contexts = contexts_of(step)
    if skip is not None:
        reason = 'no reason given' if skip is True or skip == 'true' else str(skip)
        step_name = step.get('label') or step.get('group') or step.get('key') or step.get('command') or '(unnamed step)'
        skipped.append((step_name, reason, contexts))

contexts = [c for _, _, cs in skipped for c in cs]
print("notify_skipped_steps: statuses for skipped steps: %s" % (contexts or "none"), file=sys.stderr, flush=True)

if contexts:
    notify = [{'github_commit_status': {'context': c}} for c in contexts]

    # Without `--step`, this updates the running step: its entries fire when it finishes, whatever happens to the rest of the build
    subprocess.run(['buildkite-agent', 'step', 'update', 'notify', json.dumps(notify), '--append'], check=True, stdout=sys.stderr)

    # The annotation comes second: the notifications matter more, and a failure to annotate is not fatal
    cell = lambda text: str(text).replace('|', '\\|').replace('\n', ' ')
    rows = ['| %s | %s | %s |' % (cell(label), cell(reason), ', '.join('`%s`' % cell(c) for c in contexts)) for label, reason, contexts in skipped]
    intro = 'Those steps will not run, but will still report their corresponding status to GitHub.'
    body = '\n'.join(['#### Skipped steps', '', intro, '', '| Step | Reason | Status reported to GitHub |', '|---|---|---|'] + rows)
    annotation = subprocess.run(['buildkite-agent', 'annotate', '--style', 'info', '--context', 'skipped-steps'], input=body, text=True, stdout=sys.stderr)
    if annotation.returncode != 0:
        print("notify_skipped_steps: could not post the annotation", file=sys.stderr)

# Printed last, so that a failure above leaves nothing to upload
sys.stdout.write(source)
