#!/usr/bin/env bash

set -euo pipefail

# Script: annotate_test_failures
#
# Description:
#   Annotates the Buildkite build with the failures in a JUnit report, and optionally posts them to Slack.
#   The work happens in `lib/annotate_test_failures.rb`; this wrapper runs it on the calling repo's Ruby.
#
# Usage:
#   annotate_test_failures [junit-report-file-path] [--module MODULE] [--slack CHANNEL] [--slack-webhook URL]
#
# Options and arguments:
#   See `lib/annotate_test_failures.rb`, which parses them.
#
# Examples:
#   annotate_test_failures build/results/report.junit
#   annotate_test_failures build/results/report.junit --slack build-and-ship
#
# Notes:
#   rbenv resolves a script's Ruby from the script's own folder, which would pick this plugin's `.ruby-version`
#   instead of the calling repo's. Exporting `RBENV_VERSION`, resolved from the caller's working directory,
#   takes precedence over any `.ruby-version`. A caller's own `RBENV_VERSION` is kept.
#   Without rbenv, the script runs on whatever `ruby` is on the `PATH`.
#   If rbenv can't resolve the caller's Ruby (e.g. it isn't installed), this fails loudly rather than falling back.
#
# Returns:
#   The exit status of `lib/annotate_test_failures.rb`.
#
# Requirements:
#   `ruby`; `rbenv` is optional.

if [[ -z "${RBENV_VERSION:-}" ]] && command -v rbenv > /dev/null; then
  RBENV_VERSION="$(rbenv version-name)"
  export RBENV_VERSION
fi

exec ruby "$(dirname "${BASH_SOURCE[0]}")/../lib/annotate_test_failures.rb" "$@"
