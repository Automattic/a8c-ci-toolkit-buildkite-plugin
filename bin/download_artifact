#!/usr/bin/env bash

set -eu

# Usage
# download_artifact $file_name [$destination]
#
# $file_name should be the name of the file - it'll automatically be combined with the current build ID to differentiate between
# the same file in different jobs. It'll be identical to the `basename` of whatever you passed to `store_artifact`.
#
# $destination is an optional argument – by default, `download_artifact` will download the artifact to the present working directory,
# but if you'd like it stored elsewhere, just pass the path as the second argument.
#
# On CI agents that set the `BUILDKITE_NAS_ARTIFACTS_S3_*` variables (our macOS fleet in MacMiniVault), the file is downloaded
# from the S3 server on the Synology NAS first, and from S3 only if that fails.

ARTIFACT_FILE_NAME=${1-}

if [ -z "$ARTIFACT_FILE_NAME" ]; then
	echo "You must pass the name of the file you want to download"
	exit 1
fi

BUCKET=${ARTIFACTS_S3_BUCKET-}

if [ -z "$BUCKET" ]; then
	echo "You must pass set the \`ARTIFACTS_S3_BUCKET\` environment variable with the S3 bucket you'd like to use"
	exit 2
fi

OUTPUT_PATH=${2-.}

KEY="$BUILDKITE_BUILD_ID/$ARTIFACT_FILE_NAME"

NAS_ENDPOINT=${BUILDKITE_NAS_ARTIFACTS_S3_ENDPOINT:-}
NAS_BUCKET=${BUILDKITE_NAS_ARTIFACTS_S3_BUCKET:-}
NAS_ACCESS_KEY_ID=${BUILDKITE_NAS_ARTIFACTS_S3_ACCESS_KEY_ID:-}
NAS_SECRET_ACCESS_KEY=${BUILDKITE_NAS_ARTIFACTS_S3_SECRET_ACCESS_KEY:-}

SHOULD_TRY_NAS=false
[[ -n "$NAS_ENDPOINT" && -n "$NAS_BUCKET" && -n "$NAS_ACCESS_KEY_ID" && -n "$NAS_SECRET_ACCESS_KEY" ]] && SHOULD_TRY_NAS=true

# The NAS credentials replace the agent's AWS credentials for this one call, so the AWS ones never reach the NAS.
aws_nas() {
	env -u AWS_PROFILE -u AWS_SESSION_TOKEN \
		AWS_ACCESS_KEY_ID="$NAS_ACCESS_KEY_ID" AWS_SECRET_ACCESS_KEY="$NAS_SECRET_ACCESS_KEY" AWS_MAX_ATTEMPTS=1 \
		aws s3 "$@" --endpoint-url "$NAS_ENDPOINT" --region us-east-1 --cli-connect-timeout 5
}

download_from_nas() {
	[[ "$SHOULD_TRY_NAS" == true ]] || return 1

	# Use the same destination rules as the S3 download: a directory keeps the file name, anything else is the file path.
	local destination="$OUTPUT_PATH"
	if [[ -d "$OUTPUT_PATH" || "$OUTPUT_PATH" == */ ]]; then
		mkdir -p "$OUTPUT_PATH"
		destination="${OUTPUT_PATH%/}/$ARTIFACT_FILE_NAME"
	fi

	echo "Downloading from NAS (Synology)"
	aws_nas cp "s3://$NAS_BUCKET/$BUILDKITE_BUILD_ID-$ARTIFACT_FILE_NAME" "$destination" && return 0
	rm -f "$destination"
	return 1
}

download_from_s3() {
	# If the bucket has transfer acceleration enabled, use it!
	local acceleration_status
	acceleration_status=$(aws s3api get-bucket-accelerate-configuration --bucket "$BUCKET" | jq '.Status' -r || true)

	if [[ "$acceleration_status" == "Enabled" ]]; then
		echo "Downloading from S3 with transfer acceleration"
		aws s3 cp "s3://$BUCKET/$KEY" "$OUTPUT_PATH" --endpoint-url https://s3-accelerate.amazonaws.com
	else
		echo "Downloading from S3"
		aws s3 cp "s3://$BUCKET/$KEY" "$OUTPUT_PATH"
	fi || return 1

	if [[ "$SHOULD_TRY_NAS" == true ]]; then
		annotate "NAS download failed, downloaded from S3 instead: \`$ARTIFACT_FILE_NAME\`"
	fi
}

annotate() {
	command -v buildkite-agent > /dev/null 2>&1 || return 0
	printf -- "- %s\n" "$1" | buildkite-agent annotate --context nas-artifacts --scope job --style warning --append || echo "⚠️ nas-artifacts annotation failed"
}

download_from_nas || download_from_s3
